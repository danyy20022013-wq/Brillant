# Copia este archivo como .env (está ignorado por git) y cambia los valores.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.

# Dirección y puerto donde escucha el servidor.
HOST=127.0.0.1
PUERTO=8080

# desarrollo: acepta la app desde cualquier puerto de http://localhost
#             y http://127.0.0.1.
# produccion: solo los orígenes de ORIGENES_PERMITIDOS.
MODO=desarrollo

# Orígenes permitidos en producción, separados por comas.
ORIGENES_PERMITIDOS=https://brilliant.ejemplo.com

# Archivo SQLite donde se guardan las cuentas (ignorado por git).
RUTA_BASE_DATOS=brilliant.db

# Costo de bcrypt (4 a 15; en producción, al menos 10). Cada +1 duplica el
# tiempo de crear la cuenta y de iniciar sesión.
COSTO_BCRYPT=10

# Clave para firmar los tokens: OBLIGATORIA, de al menos 32 bytes.
# Genera una con: dart run bin/generar_secreto.dart
# Queda vacía a propósito: sin clave el servidor no arranca.
JWT_SECRETO=
